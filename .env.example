# rugpulltool Environment Configuration

# Cache TTL in seconds (default: 300 = 5 minutes)
CACHE_TTL_SECONDS=300

# Optional: RugCheck API JWT key (if you have higher-tier rate limits)
RUGCHECK_API_KEY=

# Optional: Public base URL for metadata/open graph
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Launch Studio
# ---------------------------------------------------------------------------

# RPC used to broadcast launch transactions. The public endpoint works for a
# single tx but will rate-limit under real load — use Helius/QuickNode.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Server-only. Pinata JWT for pinning token images + metadata JSON to IPFS.
# https://app.pinata.cloud/developers/api-keys
PINATA_JWT=

# ---------------------------------------------------------------------------
# Auth + database
# ---------------------------------------------------------------------------

# MySQL connection string. Create the database first, then run `npm run db:push`.
DATABASE_URL="mysql://user:password@localhost:3306/rugpulltool"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Must match the URL the app is served from. In production set the real domain.
NEXTAUTH_URL=http://localhost:3001

# Google OAuth. Leave blank to hide the "Continue with Google" button and run
# email/password only. Authorised redirect URI:
#   http://localhost:3001/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Solana Pay billing
# ---------------------------------------------------------------------------

# Public treasury address that receives subscription payments. Required for
# checkout. The server verifies recipient + amount + reference on-chain.
NEXT_PUBLIC_TREASURY_WALLET=
