generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  TESTER
  BASIC
  ADVANCED
  PREMIUM
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  EXPIRED
}

model User {
  id            String    @id @default(cuid())
  name          String?   @db.VarChar(80)
  email         String    @unique @db.VarChar(191)
  emailVerified DateTime?
  image         String?   @db.VarChar(512)
  // Null for OAuth-only accounts.
  passwordHash  String?   @db.VarChar(255)
  plan          Plan      @default(FREE)
  // Null on paid tiers = lifetime access. Set for Tester (one week).
  planExpiresAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  payments Payment[]

  @@index([plan])
  @@map("users")
}

/*
 * Standard NextAuth models. The app currently runs on JWT sessions, so these
 * stay empty — they exist so switching to `strategy: "database"` later is a
 * one-line change rather than a migration.
 */

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  // Aiven MySQL enforces sql_require_primary_key, so this table needs an
  // explicit primary key. (identifier, token) is unique by NextAuth design.
  @@id([identifier, token])
  @@map("verification_tokens")
}

/*
 * Solana Pay checkout. A Payment row is the intent: it pins the plan, amount,
 * treasury recipient and a one-time reference key. The reference is embedded
 * in the Solana Pay transfer so the server can find the matching transaction.
 * A signature is only ever written once (unique), which makes verification
 * idempotent and blocks replaying someone else's transfer.
 */
model Payment {
  id             String        @id @default(cuid())
  userId         String
  plan           Plan
  amountLamports BigInt
  reference      String        @unique @db.VarChar(64)
  status         PaymentStatus @default(PENDING)
  signature      String?       @unique @db.VarChar(128)
  expiresAt      DateTime
  confirmedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("payments")
}
